      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Trim whitespace on all string fields\nconst data = {};\nfor (const [key, value] of Object.entries($json)) {\n  data[key] = typeof value === 'string' ? value.trim() : value;\n}\n\n// Lowercase email address\nconst email = (data.Email ?? '').toLowerCase();\n\n// Coerce attendees to an integer. Default to 1 if missing/zero\nconst attendees = parseInt(data['Number of attendees'], 10) || 1;\n\n// Check that email is likely valid\nconst valid = email.includes('@') && email.includes('.');\n\nconst dietary = data['Dietary needs or allergies']\nconst member = data['Are you a member?']\nconst phone = data['Phone number']\nconst questions = data['Questions?']\n\n// Return normalized record\nreturn {\n  name: data.Name,\n  email,\n  attendees,\n  dietary,\n  member,\n  phone,\n  questions,\n  event_id: 'summer-bbq-2026',\n  timestamp: new Date().toISOString(),\n  valid,\n};"
      },
