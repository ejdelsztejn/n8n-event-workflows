    {
      "parameters": {
        "jsCode": "const CAPACITY = 50; // hardcoded for v1\n\n// New submission, fetched from Node 2 by node name\nconst rsvp = $('Code in JavaScript').first().json;\n\n// Sum attendees across the sheet rows from Node 4\nconst currentHeadcount = $input.all().reduce(\n  (sum, item) => sum + (Number(item.json.attendees) || 0),\n  0\n);\n\nconst newTotal = currentHeadcount + rsvp.attendees;\n\nreturn [{\n  json: {\n    ...rsvp,\n    current_headcount: currentHeadcount,\n    new_total: newTotal,\n    capacity: CAPACITY,\n    has_room: newTotal <= CAPACITY,\n  },\n}];"
      },
